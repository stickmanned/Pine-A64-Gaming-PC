# Pine A64 Gaming PC KMS/DRM and input access rules
# Allows the normal DietPi user session to access render and input devices
# needed by Moonlight's embedded DRM/KMS path.

SUBSYSTEM=="drm", MODE="0666"
KERNEL=="renderD*", MODE="0666"
KERNEL=="card*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="mice", MODE="0666"
